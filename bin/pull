#!/usr/bin/env bash
# Copies the docs from the Turbo Laravel package repository into the site:
#   2.x docs/ -> source/_docs
#   1.x docs/ -> source/_v1
# Both folders are git-ignored; this mirrors what .github/workflows/publish.yml does on deploy.
set -euo pipefail

cd "$(dirname "$0")/.."

repo="https://github.com/hotwired-laravel/turbo-laravel.git"

if [ ! -d package-src/.git ]; then
  git clone --quiet --no-checkout "$repo" package-src
fi

git -C package-src fetch --quiet origin 2.x 1.x

copy_docs() {
  local branch="$1" target="$2"

  rm -rf "$target"
  mkdir -p "$target"
  git -C package-src archive "origin/$branch" docs | tar -x --strip-components=1 -C "$target"

  echo "Copied $branch docs into $target ($(git -C package-src rev-parse --short "origin/$branch"))"
}

copy_docs 2.x source/_docs
copy_docs 1.x source/_v1
